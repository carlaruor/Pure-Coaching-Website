# Server-side secrets for local Edge Function development only.
# Copy to supabase/functions/.env.local; that file is ignored by Git.
RESEND_API_KEY=re_placeholder
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
RATE_LIMIT_ENABLED=true
ALLOWED_ORIGINS=https://your-github-pages-origin.example
DOCUMENT_UPLOADS_ENABLED=false

# Private Support Checkout remains unavailable until the migration, Stripe
# test catalogue and future payment webhook have passed review.
PRIVATE_CHECKOUT_ENABLED=false
STRIPE_CHECKOUT_ENVIRONMENT=test
# Generate at least 32 random bytes and keep this server-side. It authorises
# controlled sandbox requests and must never be added to public JavaScript.
PRIVATE_CHECKOUT_TESTER_TOKEN=replace-with-high-entropy-server-only-token
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-sandbox-secret
STRIPE_PRICE_5_SESSIONS=price_replace-with-five-session-test-price
STRIPE_PRICE_10_SESSIONS=price_replace-with-ten-session-test-price
STRIPE_PRICE_15_SESSIONS=price_replace-with-fifteen-session-test-price
PRIVATE_CHECKOUT_SUCCESS_URL=https://your-github-pages-origin.example/payment-success.html?session_id={CHECKOUT_SESSION_ID}
PRIVATE_CHECKOUT_CANCEL_URL=https://your-github-pages-origin.example/private-support.html?payment=cancelled
